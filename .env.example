# Copy to .env.local (never committed: .env* is in .gitignore) and fill in.
# Keys stay on the server: the browser only sees configuration ids and labels.

# ---------- LLM configuration 1 (default) - any OpenAI-compatible endpoint ----------
# Example: Google Gemini through its OpenAI-compatible endpoint
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=
LLM_MODEL=gemini-3.6-flash
LLM_LABEL=Gemini Flash
# json_schema (provider enforces the schema) | prompt (format described in the prompt only)
LLM_STRUCTURED_OUTPUT=json_schema
# Prices in USD per 1M tokens (used to compute cost; 0 if free)
LLM_PRICE_INPUT_PER_M=0
LLM_PRICE_OUTPUT_PER_M=0

# ---------- LLM configuration 2 (optional) - shown in the model menu ----------
# Example: the school-hosted models (URL + personal key sent by the course team)
LLM2_BASE_URL=
LLM2_API_KEY=
LLM2_MODEL=
LLM2_LABEL=School model
LLM2_STRUCTURED_OUTPUT=prompt
LLM2_PRICE_INPUT_PER_M=0
LLM2_PRICE_OUTPUT_PER_M=0

# ---------- LLM configuration 3 (optional) ----------
LLM3_BASE_URL=
LLM3_API_KEY=
LLM3_MODEL=
LLM3_LABEL=

# ---------- Decision model ----------
# Default: vLLM Semantic Router "Decision 3.0" free hosted API (System One format).
# Get a key at https://decision.vllm-sr.ai/keys  (requests are logged by the provider:
# do not send real customer data).
DM_BASE_URL=https://decision.vllm-sr.ai
DM_API_KEY=
DM_MODEL=vllm-sr/d3-flash
DM_LABEL=Decision 3.0 d3-flash
# systemone (POST /v1/systemone: vLLM SR, TypeSafe Jev, OpenRouter /api/v1/systemone)
# decisions (POST /v1/decisions: OpenAI-style contract)
DM_API_FORMAT=systemone
DM_PRICE_INPUT_PER_M=0
# dm+llm: if the DM's confidence (category or priority) is below this, the LLM decides instead
DM_CONFIDENCE_THRESHOLD=0.6
DM_TIMEOUT_MS=15000

# ---------- Limits ----------
MAX_TICKET_CHARS=5000
LLM_TIMEOUT_MS=30000
LLM_MAX_RETRIES=1
SMOKE_CONCURRENCY=4
